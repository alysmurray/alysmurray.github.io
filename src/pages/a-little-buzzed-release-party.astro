---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
const siteUrl = import.meta.env.SITE || 'https://alysmurray.com';

const eventbriteUrl = 'https://www.eventbrite.com/e/alys-murray-at-the-gdbs-tickets-1981247874727';

const eventJsonLd = {
  "@context": "https://schema.org",
  "@type": "LiteraryEvent",
  "name": "A Little Buzzed Release Party with Alys Murray",
  "description": "Join Alys Murray for the A Little Buzzed release party at the Garden District Book Shop in New Orleans. An evening of conversation with Molly Tullis, plus signed and personalized copies.",
  "startDate": "2026-02-24T18:00:00-06:00",
  "endDate": "2026-02-24T20:00:00-06:00",
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": {
    "@type": "Place",
    "name": "Garden District Book Shop",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "2727 Prytania Street",
      "addressLocality": "New Orleans",
      "addressRegion": "LA",
      "postalCode": "70130",
      "addressCountry": "US"
    }
  },
  "image": new URL(`${base}images/books/full/a-little-buzzed.jpg`, siteUrl).href,
  "performer": [
    {
      "@type": "Person",
      "name": "Alys Murray"
    },
    {
      "@type": "Person",
      "name": "Molly Tullis"
    }
  ],
  "organizer": {
    "@type": "Organization",
    "name": "Garden District Book Shop",
    "url": "https://www.gardendistrictbookshop.com"
  },
  "offers": {
    "@type": "AggregateOffer",
    "url": eventbriteUrl,
    "lowPrice": "0",
    "highPrice": "20.94",
    "priceCurrency": "USD",
    "availability": "https://schema.org/InStock"
  },
  "about": {
    "@type": "Book",
    "name": "A Little Buzzed",
    "author": {
      "@type": "Person",
      "name": "Alys Murray"
    }
  }
};
---

<Layout
  title="A Little Buzzed Release Party | Alys Murray at Garden District Book Shop, New Orleans"
  description="Join Alys Murray for the A Little Buzzed release party on February 24, 2026 at the Garden District Book Shop in New Orleans. Conversation with Molly Tullis, plus signed and personalized copies."
  image="images/books/full/a-little-buzzed.jpg"
>
  <!-- JSON-LD Event Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />

  <!-- Hero -->
  <section class="relative py-24 md:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-[#243551]"></div>

    <!-- Decorative elements -->
    <div class="absolute top-10 left-10 w-64 h-64 bg-white/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-10 right-10 w-96 h-96 bg-rose/10 rounded-full blur-3xl"></div>

    <div class="relative max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">
        <!-- Book Cover -->
        <div class="flex justify-center md:justify-end order-2 md:order-1">
          <div class="relative">
            <div class="absolute -inset-4 bg-white/20 rounded-3xl blur-xl"></div>
            <img
              src={`${base}images/books/full/a-little-buzzed.jpg`}
              alt="A Little Buzzed book cover"
              class="relative w-72 md:w-80 rounded-2xl shadow-2xl transform hover:scale-105 transition-transform duration-500"
            />
          </div>
        </div>

        <!-- Content -->
        <div class="order-1 md:order-2 text-center md:text-left">
          <span class="inline-block px-4 py-2 bg-white/20 text-white rounded-full text-sm font-medium mb-6">
            February 24, 2026 &middot; New Orleans
          </span>
          <h1 class="text-white mb-6">
            A Little Buzzed<br/>
            <span class="text-3xl md:text-4xl">Release Party</span>
          </h1>
          <p class="text-white/90 text-lg leading-relaxed mb-4">
            Join bestselling author Alys Murray for an evening celebrating the release of <em>A Little Buzzed</em> at the Garden District Book Shop.
          </p>
          <p class="text-white/70 text-base mb-8">
            Tuesday, Feb 24 &middot; 6:00&ndash;8:00 PM CST
          </p>
          <a
            href={eventbriteUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-8 py-4 bg-white text-[#243551] rounded-full font-medium hover:bg-cream transition-colors text-lg"
          >
            Get Tickets
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Event Details -->
  <section class="py-24 bg-cream">
    <div class="max-w-4xl mx-auto px-6">
      <div class="bg-gradient-to-br from-rose-light/30 to-cream-dark rounded-3xl p-8 md:p-12">
        <div class="grid md:grid-cols-3 gap-8 text-center">
          <!-- When -->
          <div>
            <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-burgundy/10 flex items-center justify-center">
              <svg class="w-7 h-7 text-burgundy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
            <h3 class="font-serif text-xl mb-2">When</h3>
            <p class="text-charcoal-light">Tuesday, February 24, 2026</p>
            <p class="text-charcoal-light">6:00&ndash;8:00 PM CST</p>
          </div>

          <!-- Where -->
          <div>
            <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-burgundy/10 flex items-center justify-center">
              <svg class="w-7 h-7 text-burgundy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <h3 class="font-serif text-xl mb-2">Where</h3>
            <p class="text-charcoal-light">Garden District Book Shop</p>
            <p class="text-charcoal-light">2727 Prytania Street</p>
            <p class="text-charcoal-light">New Orleans, LA 70130</p>
          </div>

          <!-- Tickets -->
          <div>
            <div class="w-14 h-14 mx-auto mb-4 rounded-full bg-burgundy/10 flex items-center justify-center">
              <svg class="w-7 h-7 text-burgundy" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
              </svg>
            </div>
            <h3 class="font-serif text-xl mb-2">Tickets</h3>
            <p class="text-charcoal-light">Free RSVP available</p>
            <p class="text-charcoal-light">Book bundles up to $20.94</p>
            <a
              href={eventbriteUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block mt-3 text-burgundy font-medium hover:text-burgundy-dark transition-colors"
            >
              View on Eventbrite &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About the Event -->
  <section class="py-24 bg-cream-dark">
    <div class="max-w-3xl mx-auto px-6">
      <span class="block text-burgundy uppercase tracking-[0.2em] text-sm font-medium text-center">About the Event</span>
      <h2 class="font-serif text-2xl md:text-3xl mt-4 mb-8 text-center">An Evening with Alys Murray</h2>

      <p class="text-charcoal-light leading-relaxed mb-6 text-center">
        Celebrate the release of <em>A Little Buzzed</em> with author Alys Murray at the historic Garden District Book Shop in New Orleans. The evening will feature a conversation between Alys and Molly Tullis about the book, the writing process, and all things romance.
      </p>

      <p class="text-charcoal-light leading-relaxed mb-6 text-center">
        Attendees will have the opportunity to get signed and personalized copies of <em>A Little Buzzed</em>, along with an exclusive sweet and spicy sticker pack. Whether you're a longtime fan or new to Murray's romantic comedies, this release party is a night you won't want to miss.
      </p>

      <p class="text-charcoal-light leading-relaxed text-center">
        Tickets are available through Eventbrite, with options ranging from a free RSVP to book bundle packages. Space is limited, so reserve your spot today.
      </p>
    </div>
  </section>

  <!-- The Book -->
  <section class="py-24 bg-cream">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <span class="block text-burgundy uppercase tracking-[0.2em] text-sm font-medium">The Book</span>
      <h2 class="font-serif text-2xl md:text-3xl mt-4 mb-6">A Little Buzzed</h2>

      <p class="text-charcoal-light leading-relaxed mb-8 max-w-2xl mx-auto">
        A sex toy engineer with one big secret finally meets her match, and together they'll put their own products to the test in this steamy romantic comedy from bestselling author Alys Murray.
      </p>

      <a
        href={`${base}a-little-buzzed`}
        class="inline-flex items-center gap-2 px-6 py-3 bg-burgundy text-cream rounded-full font-medium hover:bg-burgundy-dark transition-colors"
      >
        Buy the Book
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- CTA Footer -->
  <section class="py-16 bg-[#243551] text-white">
    <div class="max-w-4xl mx-auto px-6 flex flex-col items-center">
      <h2 class="font-serif text-2xl md:text-3xl mb-6 text-white text-center">Don't Miss the Party!</h2>
      <p class="text-white/90 mb-8 text-lg text-center">
        February 24, 2026 at the Garden District Book Shop in New Orleans.
      </p>
      <a
        href={eventbriteUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-8 py-4 bg-white text-[#243551] rounded-full font-medium hover:bg-cream transition-colors text-lg"
      >
        Get Tickets on Eventbrite
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
        </svg>
      </a>
    </div>
  </section>
</Layout>
