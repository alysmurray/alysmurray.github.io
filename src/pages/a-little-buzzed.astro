---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL;
---

<Layout title="A Little Buzzed | Alys Murray" description="Buy A Little Buzzed by Alys Murray. Available now from Garden District Book Shop and other retailers.">
  <!-- Hero -->
  <section class="relative py-24 md:py-32 overflow-hidden">
    <div class="absolute inset-0 bg-[#243551]"></div>

    <!-- Decorative elements -->
    <div class="absolute top-10 left-10 w-64 h-64 bg-white/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-10 right-10 w-96 h-96 bg-rose/10 rounded-full blur-3xl"></div>

    <div class="relative max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 md:gap-16 items-center">
        <!-- Book Cover -->
        <div class="flex justify-center md:justify-end order-2 md:order-1">
          <div class="relative">
            <div class="absolute -inset-4 bg-white/20 rounded-3xl blur-xl"></div>
            <img
              src={`${base}images/books/full/a-little-buzzed.jpg`}
              alt="A Little Buzzed book cover"
              class="relative w-72 md:w-80 rounded-2xl shadow-2xl transform hover:scale-105 transition-transform duration-500"
            />
          </div>
        </div>

        <!-- Content -->
        <div class="order-1 md:order-2 text-center md:text-left">
          <span class="inline-block px-4 py-2 bg-white/20 text-white rounded-full text-sm font-medium mb-6">
            Available Now
          </span>
          <h1 class="text-white mb-6">
            A Little Buzzed<br/>
            <span class="text-3xl md:text-4xl">Out Now!</span>
          </h1>
          <p class="text-white/90 text-lg leading-relaxed mb-8">
            The newest romantic comedy from bestselling author Alys Murray is here!
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Buy from Garden District -->
  <section class="py-24 bg-cream">
    <div class="max-w-4xl mx-auto px-6">
      <div class="bg-gradient-to-br from-rose-light/30 to-cream-dark rounded-3xl p-8 md:p-12 text-center">
        <h2 class="font-serif text-2xl md:text-3xl mb-6">Get Your Copy</h2>

        <p class="text-xl text-charcoal leading-relaxed mb-8 max-w-2xl mx-auto">
          Pick up <strong>A Little Buzzed</strong> from our preferred bookshop, the Garden District Book Shop in New Orleans.
        </p>

        <a
          href="https://www.gardendistrictbookshop.com/product-page/a-little-buzzed"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex flex-col items-center px-8 py-4 bg-burgundy text-cream rounded-2xl font-medium hover:bg-burgundy-dark transition-all hover:scale-105 shadow-lg hover:shadow-xl"
        >
          <span class="flex items-center gap-3 text-lg">
            Buy from Garden District Book Shop
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </span>
          <span class="text-cream/70 text-xs mt-1">New Orleans' beloved independent bookstore since 1979</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Other Retailers -->
  <section class="py-24 bg-cream-dark">
    <div class="max-w-4xl mx-auto px-6 flex flex-col items-center">
      <h2 class="font-serif text-2xl mb-4 text-center">Also Available At</h2>
      <p class="text-charcoal-light mb-12 text-center">Buy from your favorite retailer</p>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 w-full">
        <a
          href="https://www.barnesandnoble.com/w/a-little-buzzed-alys-murray/1147444466"
          target="_blank"
          rel="noopener noreferrer"
          class="p-6 bg-cream rounded-2xl hover:shadow-lg transition-all hover:-translate-y-1 group text-center"
        >
          <span class="font-medium text-charcoal group-hover:text-burgundy transition-colors">Barnes & Noble</span>
        </a>

        <a
          href="https://www.amazon.com/dp/0593819713"
          target="_blank"
          rel="noopener noreferrer"
          class="p-6 bg-cream rounded-2xl hover:shadow-lg transition-all hover:-translate-y-1 group text-center"
        >
          <span class="font-medium text-charcoal group-hover:text-burgundy transition-colors">Amazon</span>
        </a>

        <a
          href="https://books.apple.com/us/book/a-little-buzzed/id6670429807"
          target="_blank"
          rel="noopener noreferrer"
          class="p-6 bg-cream rounded-2xl hover:shadow-lg transition-all hover:-translate-y-1 group text-center"
        >
          <span class="font-medium text-charcoal group-hover:text-burgundy transition-colors">Apple Books</span>
        </a>

        <a
          href="https://bookshop.org/p/books/a-little-buzzed-alys-murray/e7971b0a88b1c8cd"
          target="_blank"
          rel="noopener noreferrer"
          class="p-6 bg-cream rounded-2xl hover:shadow-lg transition-all hover:-translate-y-1 group text-center"
        >
          <span class="font-medium text-charcoal group-hover:text-burgundy transition-colors">Bookshop.org</span>
        </a>
      </div>
    </div>
  </section>

  <!-- About the Book -->
  <section class="py-24 bg-cream">
    <div class="max-w-3xl mx-auto px-6 flex flex-col items-center">
      <span class="text-burgundy uppercase tracking-[0.2em] text-sm font-medium text-center">About the Book</span>
      <h2 class="font-serif text-2xl md:text-3xl mt-4 mb-8 text-center">A Little Buzzed</h2>

      <p class="font-serif text-xl italic text-charcoal-light leading-relaxed mb-8 text-center">
        "If she builds it, they will come."
      </p>

      <p class="text-charcoal-light leading-relaxed mb-6 text-center">
        A sex toy engineer with one big secret finally meets her match, and together they'll put their own products to the test in this steamy romantic comedy.
      </p>

      <p class="text-charcoal-light leading-relaxed text-center">
        Scout Porter is screwed. Not literally, of course. Literally, she's a twenty-six-year-old virgin, thanks to a relationship so disastrous she swore off love and sex for good. Metaphorically, she's screwed because she's just been assigned to work with the most annoyingly charming software developer she's ever met...
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-[#243551] text-white">
    <div class="max-w-4xl mx-auto px-6 flex flex-col items-center">
      <h2 class="font-serif text-2xl md:text-3xl mb-6 text-white text-center">Get Your Copy Today</h2>
      <p class="text-white/90 mb-8 text-lg text-center">
        Available now from Garden District Book Shop and other retailers.
      </p>
      <a
        href="https://www.gardendistrictbookshop.com/product-page/a-little-buzzed"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-8 py-4 bg-white text-[#243551] rounded-full font-medium hover:bg-cream transition-colors text-lg"
      >
        Buy Now
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </section>
</Layout>
