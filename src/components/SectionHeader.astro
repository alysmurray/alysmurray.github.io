---
interface Props {
  label?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  showLabel?: boolean;
}

const { label, title, description, align = 'center', showLabel = false } = Astro.props;

const alignClasses = {
  left: 'text-left',
  center: 'text-center mx-auto',
};
---

<header class:list={["max-w-2xl", alignClasses[align]]}>
  <!-- Preserve labels on surfaces where the original layout is requested. -->
  {showLabel && label && (
    <span class="inline-block text-xs font-medium uppercase tracking-[0.2em] text-burgundy mb-4">{label}</span>
  )}
  <h2 class="font-serif">{title}</h2>

  {description && (
    <p class="mt-4 text-charcoal-light text-lg">
      {description}
    </p>
  )}
</header>
